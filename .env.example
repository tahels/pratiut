# ============================================
# פרטיות - משתני סביבה
# ============================================
# העתק קובץ זה ל-.env.local והכנס ערכים אמיתיים
# קובץ .env.local לא נשמר ב-Git (ראה .gitignore)

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend - שליחת מיילים מטפסים
# הירשם ב: https://resend.com
RESEND_API_KEY=

# Contact form recipient
CONTACT_EMAIL=info@pratiut.co.il

# Analytics (אופציונלי - Vercel Analytics מובנה)
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
